---
import SectionHeader from './SectionHeader.astro';

const ORANGECAT_URL = 'https://orangecatlabs.ca';
---

<section id="contact" class="py-20 px-6">
  <div class="container mx-auto max-w-6xl reveal">
    <SectionHeader number="05" label="INQUIRY" title="Start a Project" />

    <div class="grid md:grid-cols-2 gap-12 mt-8">
      <form name="contact" method="POST" action="/success" data-netlify="true" netlify-honeypot="bot-field" class="space-y-4">
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden">
          <label>Don't fill this out: <input name="bot-field" /></label>
        </p>

        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label for="name" class="font-mono text-xs text-text-muted tracking-wider block mb-2">NAME *</label>
            <input type="text" id="name" name="name" required
              class="w-full bg-surface border border-surface-border rounded-btn px-4 py-2.5 text-text-primary text-sm focus:border-accent-indigo/60 focus:ring-1 focus:ring-accent-indigo/30 outline-none transition-colors"
              placeholder="Your name" />
          </div>

          <div>
            <label for="email" class="font-mono text-xs text-text-muted tracking-wider block mb-2">EMAIL *</label>
            <input type="email" id="email" name="email" required
              class="w-full bg-surface border border-surface-border rounded-btn px-4 py-2.5 text-text-primary text-sm focus:border-accent-indigo/60 focus:ring-1 focus:ring-accent-indigo/30 outline-none transition-colors"
              placeholder="your@company.com" />
          </div>
        </div>

        <div>
          <label for="project_type" class="font-mono text-xs text-text-muted tracking-wider block mb-2">PROJECT TYPE *</label>
          <select id="project_type" name="project_type" required
            class="w-full bg-surface border border-surface-border rounded-btn px-4 py-2.5 text-text-primary text-sm focus:border-accent-indigo/60 focus:ring-1 focus:ring-accent-indigo/30 outline-none transition-colors">
            <option value="" disabled selected>Select project category...</option>
            <option value="Full-Stack Web / Software App">Full-Stack Web / Software Application</option>
            <option value="Cloud Infrastructure / DevOps">Cloud Infrastructure & DevOps</option>
            <option value="AI Integration / Automation">AI Integration & Workflow Automation</option>
            <option value="System Modernization / Optimization">System Modernization & Optimization</option>
            <option value="Other / Advisory">Other / Advisory & Architecture Review</option>
          </select>
        </div>

        <div>
          <label for="timeline" class="font-mono text-xs text-text-muted tracking-wider block mb-2">TARGET TIMELINE</label>
          <select id="timeline" name="timeline"
            class="w-full bg-surface border border-surface-border rounded-btn px-4 py-2.5 text-text-primary text-sm focus:border-accent-indigo/60 focus:ring-1 focus:ring-accent-indigo/30 outline-none transition-colors">
            <option value="Flexible">Flexible</option>
            <option value="Immediate (< 1 month)">Immediate (&lt; 1 month)</option>
            <option value="1 – 3 months">1 – 3 months</option>
            <option value="3 – 6 months">3 – 6 months</option>
          </select>
        </div>

        <div>
          <label for="message" class="font-mono text-xs text-text-muted tracking-wider block mb-2">PROJECT BRIEF *</label>
          <textarea id="message" name="message" required rows="4"
            class="w-full bg-surface border border-surface-border rounded-btn px-4 py-3 text-text-primary text-sm focus:border-accent-indigo/60 focus:ring-1 focus:ring-accent-indigo/30 outline-none transition-colors resize-none"
            placeholder="Tell us about your project, current architecture, key goals, or challenges..."></textarea>
        </div>

        <button type="submit"
          class="w-full sm:w-auto px-8 py-3 bg-accent-indigo rounded-btn text-white text-sm font-semibold hover:bg-accent-indigo/90 transition-colors duration-200">
          Submit Project Brief →
        </button>
      </form>

      <div class="space-y-6">
        <div>
          <div class="font-mono text-xs text-accent-indigo tracking-wider mb-3">WORK WITH ORANGECAT LABS</div>
          <p class="text-text-secondary text-sm leading-relaxed mb-4">
            We partner with growing teams and enterprises to design, develop, and scale production systems. Tell us about your goals and we will respond within 1 business day.
          </p>
          <p class="text-text-muted text-xs leading-relaxed">
            Need direct communication or want to review our studio work? Visit our studio site or connect via LinkedIn.
          </p>
        </div>

        <div class="space-y-3 pt-2">
          <a href={ORANGECAT_URL} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-text-primary text-sm hover:text-accent-indigo transition-colors group">
            <span class="font-mono text-accent-indigo group-hover:translate-x-0.5 transition-transform">→</span>
            <span>orangecatlabs.ca</span>
            <span class="text-text-muted text-xs">(Studio Site)</span>
          </a>
          <a href="https://linkedin.com/in/rafael-a-gomes" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-text-secondary text-sm hover:text-accent-purple transition-colors group">
            <span class="font-mono text-accent-purple/60 group-hover:text-accent-purple">→</span>
            <span>linkedin.com/in/rafael-a-gomes</span>
          </a>
          <a href="https://github.com/rfabreu" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-text-secondary text-sm hover:text-accent-pink transition-colors group">
            <span class="font-mono text-accent-pink/60 group-hover:text-accent-pink">→</span>
            <span>github.com/rfabreu</span>
          </a>
        </div>

        <div class="p-5 bg-surface border border-surface-border rounded-card">
          <div class="font-mono text-xs text-text-muted tracking-wider mb-2">STUDIO LOCATION</div>
          <p class="text-text-secondary text-sm">Toronto, Ontario, Canada · Available Globally</p>
        </div>
      </div>
    </div>
  </div>
</section>
