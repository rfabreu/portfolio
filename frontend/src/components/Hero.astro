---
import TechTag from './TechTag.astro';
import ParticleHero from '../islands/ParticleHero.tsx';

const tags: { label: string; color: 'indigo' | 'purple' | 'pink' }[] = [
  { label: 'Go', color: 'indigo' },
  { label: 'Python', color: 'purple' },
  { label: 'React', color: 'pink' },
  { label: 'Kubernetes', color: 'indigo' },
  { label: 'AI/ML', color: 'purple' },
];

const ORANGECAT_URL = 'https://orangecatlabs.ca';
const ORANGECAT_LOGO = '/images/orangecat-labs-mark-1.svg';
---

<section id="hero" class="relative min-h-[85vh] flex items-center overflow-hidden">
  <ParticleHero client:load />

  <div class="container mx-auto max-w-6xl px-6 relative z-10">
    <div class="font-mono text-accent-indigo text-xs tracking-[3px] mb-5 animate-fade-in" style="animation-delay: 0.1s;">
      // CO-FOUNDER · ORANGECAT LABS
    </div>

    <h1 class="text-5xl sm:text-7xl md:text-8xl font-black leading-none animate-fade-up" style="letter-spacing: -0.06em; animation-delay: 0.2s;">
      RAFAEL<br />ABREU
    </h1>

    <p class="mt-5 text-text-secondary text-base md:text-lg max-w-lg leading-relaxed animate-fade-in" style="animation-delay: 0.5s;">
      I build solutions that drive results — <span class="text-accent-purple-light">full-stack applications</span>, cloud infrastructure, and AI-powered systems for businesses ready to scale.
    </p>

    <div class="mt-6 flex flex-wrap gap-2.5 animate-stagger" style="animation-delay: 0.7s;">
      {tags.map((tag) => (
        <TechTag label={tag.label} color={tag.color} />
      ))}
    </div>

    <div class="mt-8 flex flex-wrap gap-4 animate-fade-in" style="animation-delay: 1s;">
      <a
        href={ORANGECAT_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 px-6 py-2.5 bg-accent-indigo rounded-btn text-white text-sm font-semibold hover:bg-accent-indigo/90 transition-colors duration-200"
      >
        <img
          src={ORANGECAT_LOGO}
          alt=""
          width="18"
          height="18"
          class="h-4.5 w-4.5 rounded-sm bg-white object-contain p-0.5"
          loading="eager"
          decoding="async"
        />
        <span>Work with OrangeCat Labs</span>
      </a>
      <a
        href="#projects"
        class="px-6 py-2.5 border border-surface-border rounded-btn text-text-secondary text-sm font-medium hover:border-accent-indigo/40 hover:text-accent-indigo transition-colors duration-200"
      >
        View Projects
      </a>
    </div>
  </div>
</section>
