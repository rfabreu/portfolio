# Google Gemini API key — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Server configuration
PORT=8080
ALLOWED_ORIGINS=http://localhost:4321,https://your-site.netlify.app

# Per-client rate limits, requests per minute (positive integers; invalid values fall back to the default)
CHAT_RATE_LIMIT_RPM=10
GAME_RATE_LIMIT_RPM=60
# Per-client chat messages per 24h window
CHAT_CLIENT_DAILY_LIMIT=50
# Total Gemini calls per 24h window, across all clients (in memory, per machine)
CHAT_DAILY_CAP=500
# Set to 1 only behind Fly Proxy: keys the limiter on the Fly-Client-IP header. Leave unset locally.
# TRUST_FLY_CLIENT_IP=1
# Deprecated: RATE_LIMIT_RPM, when set, is the game default and can only tighten the chat default.
